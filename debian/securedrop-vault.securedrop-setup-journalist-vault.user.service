[Unit]
Description=Qubes SecureDrop Journalist Vault VM setup
ConditionPathExists=/var/run/qubes-service/securedrop-setup-journalist-vault
ConditionPathExists=!%h/Persistent/journalist-keepassx.kdbx

[Service]
Type=exec
Environment=PASS_DIR=%h/Persistent/
ExecStartPre=/usr/bin/mkdir -p ${PASS_DIR}
ExecStart=/usr/bin/cp /usr/share/securedrop/templates/journalist-keepassx.kdbx ${PASS_DIR}/

[Install]
WantedBy=default.target
