[Unit]
Description=Qubes SecureDrop Journalist Vault VM setup
ConditionPathExists=/var/run/qubes-service/securedrop-setup-journalist-vault
ConditionPathExists=!/home/user/journalist.kdbx

[Service]
Type=exec
User=user
ExecStart=cp /usr/share/securedrop/templates/journalist.kdbx /home/user/

[Install]
WantedBy=multi-user.target
